{
	"name": "@device-portal/server",
	"version": "0.0.0",
	"description": "WebSocket-based signaling server for WebRTC.",
	"type": "module",
	"main": "dist/server.js",
	"types": "dist/server.d.ts",
	"exports": {
		".": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"default": "./dist/core.js"
		}
	},
	"license": "ISC",
	"bin": {
		"device-portal-server": "dist/main.js"
	},
	"scripts": {
		"build": "tsup",
		"start": "node dist/main.js",
		"dev": "concurrently 'tsup --watch' 'node --watch-path ./dist dist/main.js'",
		"test": "tsc --noEmit && vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FilipChalupa/device-portal.git"
	},
	"keywords": [
		"webrtc",
		"server",
		"signaling",
		"websocket"
	],
	"author": {
		"name": "Filip Chalupa",
		"email": "chalupa.filip@gmail.com",
		"url": "https://www.npmjs.com/~onset"
	},
	"files": [
		"/dist/"
	],
	"dependencies": {
		"@device-portal/client": "*",
		"@hono/node-server": "^1.8.0",
		"@hono/node-ws": "^1.3.0",
		"hono": "^4.1.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"concurrently": "^9.2.1",
		"tsup": "^8.0.0",
		"typescript": "^5.9.3",
		"vitest": "^3.1.1"
	}
}
